[sub_resource type="Resource" id="Resource_vcnxq"]
script = ExtResource("18_7p0os")
speaker = "Puff"
lines = Array[String]([" Seu Puff favorito. Você usava ele antigamente para poder alcançar sua prateleira. ", "Mas agora, para realizar até mesmo essa simples ação, faz a fadiga de seu corpo gritar mais alto.", " E você já não liga mais para isso."])
metadata/_custom_type_script = "uid://cy34ykfuwqx4f"

