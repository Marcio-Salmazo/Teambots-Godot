[sub_resource type="Resource" id="Resource_joswn"]
script = ExtResource("18_7p0os")
speaker = "Armario"
lines = Array[String](["Seu velho armário. Dentro dele há uma grande desorganização de roupas e outras coisas.", "Sobre o armário, mais lembranças de gostos passados. De alguma forma, agora você parece se identificar ainda mais com aqueles bonecos.", "Mas você já não liga mais para isso. "])
metadata/_custom_type_script = "uid://cy34ykfuwqx4f"

