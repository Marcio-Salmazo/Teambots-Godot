[sub_resource type="Resource" id="Resource_p7wp1"]
script = ExtResource("18_7p0os")
speaker = "cama"
lines = Array[String](["Sua bagunçada cama.", "Acima dela você deixou suas roupas desarrumadas.", "Você não quer arrumá-las.", "Na parede, os pôsteres te lembram de seus hobbies passados.", " Eles já não parecem tão interessantes. Porque você já não liga mais para isso."])
metadata/_custom_type_script = "uid://cy34ykfuwqx4f"

