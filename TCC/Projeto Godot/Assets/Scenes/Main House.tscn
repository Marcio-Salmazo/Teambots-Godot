[sub_resource type="Resource" id="Resource_fgajp"]
script = ExtResource("21_7p0a3")
speaker = "Porta"
lines = Array[String](["O quarto de seus pais. Provavelmente não tem ninguém ali dentro, por conta de festa. ", "Mesmo não ligando, você sente que não deveria entrar."])
metadata/_custom_type_script = "uid://cy34ykfuwqx4f"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_ai4ln"]
size = Vector2(50, 109.46875)

[sub_resource type="RectangleShape2D" id="RectangleShape2D_fgajp"]
size = Vector2(75.375, 96)

[sub_resource type="Resource" id="Resource_0itf1"]
script = ExtResource("21_7p0a3")
speaker = "Armário"
lines = Array[String](["Todos esses livros te lembram de todas as aventuras que você teve ao lê-los. ", "Mas agora, a empolgação de ler cada página, foi substituída por cansaço.", "Você até pensou em olhar dentro das gavetas a baixo. Mas você já não liga mais para isso."])
metadata/_custom_type_script = "uid://cy34ykfuwqx4f"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_7ramn"]
size = Vector2(100, 51.9375)

[sub_resource type="Resource" id="Resource_6wcw1"]
script = ExtResource("21_7p0a3")
speaker = "Fotos"
lines = Array[String](["Essas 3 fotos empoeiradas estão penduradas na parede desde que você lembre.", "São fotos com sua família, de alguns acontecimentos muito coloridos e divertidos em sua vida. ", "A foto que mais chama a atenção, é um quadro separado de você e de sua mãe.", "Mas agora, parece que o brilho e a cor que esses quadros possuíam, desapareceu."])
metadata/_custom_type_script = "uid://cy34ykfuwqx4f"

